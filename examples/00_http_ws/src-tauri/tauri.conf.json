{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "frontendDist": "./www"
  },
  "productName": "Cone",
  "mainBinaryName": "Cone",
  "version": "0.1.0",
  "identifier": "trame.cone",
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "externalBin": ["sidecar/trame"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["server"],
    "targets": ["appimage", "nsis", "msi", "app", "dmg"]
  },
  "app": {
    "security": {
      "csp": "default-src 'self'"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Cone",
        "width": 800,
        "visible": false
      },
      {
        "label": "splashscreen",
        "width": 400,
        "height": 200,
        "center": true,
        "decorations": false,
        "resizable": false,
        "visible": true,
        "alwaysOnTop": true,
        "url": "splashscreen.html"
      }
    ]
  }
}
